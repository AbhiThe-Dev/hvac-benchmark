# environments and caches
.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.claude/

# logs
*.log

# separate git repo (AbhiDa-Dev/physics-hvac-pipeline)
/physics_pipeline/

# downloaded source data: regenerable via `hvac-benchmark`, and the MORTAR
# building models have UNCONFIRMED redistribution terms (see
# src/hvac_benchmark/data/mortar.py) so they must not be committed
/data_cache/

# large regenerable run outputs (keep summary docs/plots/config)
/results/trajectories/
/results/trajectories_ablation/
/results/trajectories_troubleshooting/
/symptom_pipeline/output/runs/
/symptom_pipeline/output/test_runs/

# doc_mismatch: large regenerable simulation/run artifacts (keep the .md/.json/.jsonl summary
# reports and case specs that live alongside them)
/results/docmismatch/**/*.pkl
/results/docmismatch/**/*.npz
/results/docmismatch/**/*.epw
/results/docmismatch/**/*.idf
/results/docmismatch/**/*.err
/results/docmismatch/**/*.done
/results/docmismatch_dr/**/*.pkl
/results/docmismatch_dr/**/*.npz
/results/docmismatch_dr/**/*.epw
/results/docmismatch_dr/**/*.idf
/results/docmismatch_dr/**/*.err
/results/docmismatch_dr/**/*.done

# doc_mismatch perturbation campaigns: raw EnergyPlus outputs (~600 MB), regenerable via
# doc_mismatch/scripts/45_run_perturbation_campaigns.py (the summary report at results/docmismatch/perturbation/ stays tracked)
/results/docmismatch/perturbation/campaigns/
/results/docmismatch/perturbation/feasibility/
