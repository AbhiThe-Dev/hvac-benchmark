# Copy to .env (gitignored) and fill in before starting the pilot app.
ANTHROPIC_API_KEY=

# Every login request sends a one-time code here -- never to the person requesting it. You relay the code
# to the technician by hand, each time, only when you're expecting the request.
NOTIFY_EMAIL=you@gmail.com
SMTP_FROM_EMAIL=you@gmail.com
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled on the account) --
# not your regular Gmail password, Google blocks that for SMTP.
SMTP_APP_PASSWORD=

# Optional overrides:
# PILOT_DATA_DIR=/absolute/path/to/data
# PILOT_SESSION_TTL_DAYS=10
# PILOT_CODE_TTL_MINUTES=10
# PILOT_CODE_MAX_ATTEMPTS=5
# PILOT_CODE_RESEND_COOLDOWN_SECONDS=30
# The joint model for several complaints on one air handler: "mixed" (default; considers 5%, 15%, 50% or 90% of a handler's rooms
# complaining, picked by the data) or "shipped" (the unmodified model: half of them, which cannot see a shared fault on a large handler).
# PILOT_JOINT_MODEL=mixed
