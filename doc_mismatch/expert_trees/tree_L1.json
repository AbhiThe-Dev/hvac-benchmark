                  "pos": {"op": "conclude", "cause": "damper_mech", "sure": true},
                  "neg": {
                    "op": "check", "check": ["damper_linkage"], "target": "box",
                    "why": "shaft is free: linkage slipping or disconnected, or a dead actuator",
                    "pos": {"op": "conclude", "cause": "damper_mech", "sure": true},
                    "neg": {"op": "conclude", "cause": "actuator_fail", "sure": true}
                  }
                }
              }
            },
            "pos": {
              "op": "check", "check": ["static_at_box"], "target": "box",
              "why": "damper moves but airflow is short: is the inlet starved locally (leak or blockage)?",
              "pos": {"op": "conclude", "cause": "low_static", "sure": true},
              "neg": {
                "op": "check", "check": ["flow_vs_gauge"], "target": "box",
                "why": "inlet static fine: does the controller's pressure reading match a gauge?",
                "pos": {"op": "conclude", "cause": "flow_sensor", "sure": true},
                "neg": {
                  "op": "check", "check": ["max_airflow"], "target": "box",
                  "why": "is the max airflow setpoint off the design value?",
                  "pos": {"op": "conclude", "cause": "controller_config", "sure": true},
                  "neg": {
                    "op": "check", "check": ["bas_hunting"], "target": "box",
                    "why": "5 min watch for loop tuning (damper and airflow swinging)",
                    "pos": {"op": "conclude", "cause": "controller_config", "sure": true},
                    "neg": {
                      "op": "check", "check": ["damper_linkage"], "target": "box",
                      "why": "damper moves but may not reach full travel",
                      "pos": {"op": "conclude", "cause": "damper_mech", "sure": true},
                      "neg": {"op": "escalate", "guess": "actuator_fail"}
                    }
                  }
                }
              }
            }
          },
          "neg": {
            "op": "check", "check": ["bas_reheat"], "target": "box",
