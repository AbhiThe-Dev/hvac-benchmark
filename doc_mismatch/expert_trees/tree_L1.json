              "pos": {
                "op": "check", "check": ["diffuser_duct"], "target": "box",
                "why": "in the room already (10 min): look at the diffuser and the duct behind it",
                "pos": {"op": "conclude", "cause": "duct_diffuser", "sure": true},
                "neg": {
                  "op": "check", "check": ["override_diffuser"], "target": "box",
