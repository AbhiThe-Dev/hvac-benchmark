          "pos": {
            "op": "check", "check": ["confirm_acts"], "target": "box",
            "why": "box misses its setpoint with AHU, controller and zone fine: walk to it. pos = damper moves.",
            "neg": {
              "op": "check", "check": ["power_24vac"], "target": "box",
