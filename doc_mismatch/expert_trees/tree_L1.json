    "pos": {
      "op": "check", "check": ["bas_ahu_fan", "ahu_visit"], "target": "ahu",
      "why": "static is low: read the fan so fan off is split from low static",
      "pos": {"op": "done"},
      "neg": {"op": "done"}
    },
    "neg": {"op": "done"}
  },
  "root": {
    "op": "check", "check": ["bas_static"], "target": "ahu",
    "why": "2 min at the laptop, shared across complaints. Skipped in tier C (the 17 min walk is not worth it up front).",
    "pos": {
      "op": "check", "check": ["bas_ahu_fan"], "target": "ahu",
      "why": "static low: is the fan actually off or tripped?",
      "pos": {"op": "conclude", "cause": "ahu_fan_off", "sure": true},
      "neg": {
        "op": "check", "check": ["bas_damper"], "target": "box",
        "why": "fan running, static low: is this box starved (pinned at 100% with low airflow)?",
