                  "pos": {
                    "op": "check", "check": ["flow_vs_gauge", "sensing_ports"], "target": "box",
                    "why": "box feeds the room but the hood disagrees: the sensor is suspect (gauge check on BAS tiers, port inspection in C)",
                    "pos": {"op": "conclude", "cause": "flow_sensor", "sure": true},
                    "neg": {
                      "op": "check", "check": ["k_factor"], "target": "box",
                      "why": "K-factor against the nameplate (n/a in C, falls through)",
                      "pos": {"op": "conclude", "cause": "controller_config", "sure": true},
                      "neg": {"op": "conclude", "cause": "duct_diffuser", "sure": false}
                    }
                  },
                  "neg": {
                    "op": "check", "check": ["confirm_acts"], "target": "box",
                    "why": "no airflow response: before blaming the drawings, does the documented box move at all?",
                    "pos": {
                      "op": "check", "check": ["static_at_box"], "target": "box",
                      "why": "box moves: is the inlet starved?",
                      "pos": {
                        "op": "check", "check": ["bas_ahu_fan", "ahu_visit"], "target": "ahu",
                        "why": "starved inlet: split fan off from low static",
                        "pos": {"op": "conclude", "cause": "ahu_fan_off", "sure": true},
                        "neg": {"op": "conclude", "cause": "low_static", "sure": true}
                      },
                      "neg": {"op": "find_feeder"}
                    },
                    "neg": {
                      "op": "check", "check": ["power_24vac"], "target": "box",
                      "why": "tier C mechanical chain (BAS tiers rarely get here): power first",
                      "pos": {"op": "conclude", "cause": "no_power", "sure": true},
                      "neg": {
                        "op": "check", "check": ["controller_leds"], "target": "box",
                        "why": "power fine: is the controller dead or off the network?",
                        "pos": {"op": "conclude", "cause": "controller_comms", "sure": true},
                        "neg": {
                          "op": "check", "check": ["manual_damper_test"], "target": "box",
                          "why": "is the blade stuck?",
                          "pos": {"op": "conclude", "cause": "damper_mech", "sure": true},
                          "neg": {"op": "conclude", "cause": "actuator_fail", "sure": false}
                        }
                      }
                    }
                  }
                }
              },
              "neg": {
                "op": "check", "check": ["thermostat"], "target": "box",
                "why": "airflow is as expected: sensor calibration, setpoint and mode (the BAS reads cannot catch a drifted sensor)",
                "pos": {"op": "conclude", "cause": "zone_sensor_setpoint", "sure": true},
                "neg": {
                  "op": "check", "check": ["max_airflow"], "target": "box",
                  "why": "box delivers what it is set to: are the setpoints right? (n/a in C)",
                  "pos": {"op": "conclude", "cause": "controller_config", "sure": true},
                  "neg": {
                    "op": "check", "check": ["design_load"], "target": "box",
                    "why": "room use against box design airflow",
                    "pos": {"op": "conclude", "cause": "capacity_design", "sure": true},
                    "neg": {
                      "op": "check", "check": ["reheat_coil"], "target": "box",
                      "why": "last physical check (16 min); the BAS reheat read already missed it where a BAS exists",
                      "pos": {"op": "conclude", "cause": "reheat_fail", "sure": true},
                      "neg": {"op": "escalate", "guess": "controller_config"}
                    },
                    "na": {"op": "conclude", "cause": "capacity_design", "sure": false}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
